@model MaintenanceImportRequest
<div class="modal-header">
    <h5 class="modal-title">Import Maintenance Data</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <div class="alert alert-info">Have an AI convert a manufacturer schedule or maintenance report into the template, then review every row before saving.</div>
    <label for="maintenanceImportType">Import type</label>
    <select id="maintenanceImportType" class="form-select" onchange="clearMaintenanceImportPreview()">
        <option value="Schedule">Service schedule</option>
        <option value="History">Maintenance history</option>
    </select>
    <div class="d-flex flex-wrap gap-2 mt-2">
        <button type="button" class="btn btn-outline-secondary" onclick="downloadMaintenanceTemplate()"><i class="bi bi-download me-2"></i>Download CSV template</button>
        <button type="button" class="btn btn-outline-secondary" onclick="copyMaintenanceAiPrompt()"><i class="bi bi-clipboard me-2"></i>Copy AI instructions</button>
    </div>
    <label for="maintenanceImportFile" class="mt-3">Upload CSV or JSON</label>
    <input id="maintenanceImportFile" type="file" accept=".csv,.json,text/csv,application/json" class="form-control" onchange="readMaintenanceImportFile(this)">
    <label for="maintenanceImportContent" class="mt-3">Or paste CSV or JSON</label>
    <textarea id="maintenanceImportContent" class="form-control font-monospace" rows="9" placeholder="Paste an array of JSON objects or CSV including the header row"></textarea>
    <div id="maintenanceImportResults" class="mt-3"></div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-outline-primary" onclick="previewMaintenanceImport()">Preview</button>
    <button type="button" id="commitMaintenanceImportButton" class="btn btn-primary" onclick="commitMaintenanceImport()" disabled>Import</button>
</div>
<script>
    window.maintenanceImportVehicleId = @Model.VehicleId;
</script>
